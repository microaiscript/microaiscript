<: "=== Hyperbolic Functions ==="
<: Math:sinh(0)
<: Math:cosh(0)
<: Math:tanh(0)
<: Math:asinh(0)
<: Math:acosh(1)
<: Math:atanh(0)

<: "=== Exponential/Log Functions ==="
<: Math:pow(2, 3)
<: Math:exp(0)
<: Math:expm1(0)
<: Math:log(Math:E)
<: Math:log1p(0)
<: Math:log10(100)
<: Math:log2(8)

<: "=== Random Functions ==="
<: "Random 0-1:"
<: Math:rnd()
<: "Random 1-10:"
<: Math:rnd(1, 10)
<: Math:rnd(1, 10)

<: "=== Seeded RNG (gen_rng) ==="
let rng = Math:gen_rng("test_seed")
<: "Seeded float:"
<: rng()
<: "Seeded int 1-100:"
<: rng(1, 100)
<: rng(1, 100)

<: "=== Misc Functions ==="
<: Math:clz32(1)
<: Math:fround(1.337)
<: Math:imul(2, 4)

<: "=== All Math functions working! ==="

