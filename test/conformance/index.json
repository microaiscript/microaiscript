      "program": "\n            let s = @(x) { @(y) { @(z) {\n                //let f = x(z) f(@(a){ let g = y(z) g(a) })\n                let f = x(z)\n                f(y(z))\n            }}}\n            let k = @(x){ @(y) { x } }\n            let i = @(x){ x }\n\n            // combine\n            @c(l) {\n                // extract\n                @x(v) {\n                    if (Core:type(v) == \"arr\") { c(v) } else { v }\n                }\n\n                // rec\n                @r(f, n) {\n                    if (n < l.len) {\n                        r(f(x(l[n])), (n + 1))\n                    } else { f }\n                }\n\n                r(x(l[0]), 1)\n            }\n\n            let sksik = [s, [k, [s, i]], k]\n            c([sksik, \"foo\", print])\n            ",
      "tags": [
        "core"
      ],
