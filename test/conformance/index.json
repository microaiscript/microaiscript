{
  "module": "index",
  "cases": [
    {
      "name": "index::hello_world",
      "program": "<: \"Hello, world!\"",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "str",
        "value": "Hello, world!"
      }
    },
    {
      "name": "index::expression_containing_collon_is_not_object",
      "program": "\n        <: eval {\n            Core:eq(\"ai\", \"ai\")\n        }\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "bool",
        "value": true
      }
    },
    {
      "name": "index::inc",
      "program": "\n        var a = 0\n        a += 1\n        a += 2\n        a += 3\n        <: a\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 6.0
      }
    },
    {
      "name": "index::dec",
      "program": "\n        var a = 0\n        a -= 1\n        a -= 2\n        a -= 3\n        <: a\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": -6.0
      }
    },
    {
      "name": "index::reference_is_not_chained",
      "program": "\n        var f = @() { \"a\" }\n        var g = f\n        f = @() { \"b\" }\n\n        <: g()\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "str",
        "value": "a"
      }
    },
    {
      "name": "index::empty_function",
      "program": "\n        @hoge() { }\n        <: hoge()\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "null"
      }
    },
    {
      "name": "index::empty_lambda",
      "program": "\n        let hoge = @() { }\n        <: hoge()\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "null"
      }
    },
    {
      "name": "index::lambda_that_returns_an_object",
      "program": "\n        let hoge = @() {{}}\n        <: hoge()\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "obj",
        "value": {}
      }
    },
    {
      "name": "index::closure",
      "program": "\n        @store(v) {\n            let state = v\n            @() {\n                state\n            }\n        }\n        let s = store(\"ai\")\n        <: s()\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "str",
        "value": "ai"
      }
    },
    {
      "name": "index::closure_counter",
      "program": "\n        @create_counter() {\n            var count = 0\n            {\n                get_count: @() { count },\n                count: @() { count = (count + 1) },\n            }\n        }\n\n        let counter = create_counter()\n        let get_count = counter.get_count\n        let count = counter.count\n\n        count()\n        count()\n        count()\n\n        <: get_count()\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 3.0
      },
      "skip_vm": true,
      "skip_interpreter": true
    },
    {
      "name": "index::recursion",
      "program": "\n        @fact(n) {\n            if (n == 0) { 1 } else { (fact((n - 1)) * n) }\n        }\n\n        <: fact(5)\n        ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 120.0
      }
    },
    {
      "name": "index::object::property_access",
      "program": "\n            let obj = {\n                a: {\n                    b: {\n                        c: 42,\n                    },\n                },\n            }\n\n            <: obj.a.b.c\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 42.0
      }
    },
    {
      "name": "index::object::property_access_fn_call",
      "program": "\n            @f() { 42 }\n\n            let obj = {\n                a: {\n                    b: {\n                        c: f,\n                    },\n                },\n            }\n\n            <: obj.a.b.c()\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 42.0
      }
    },
    {
      "name": "index::object::property_assign",
      "program": "\n            let obj = {\n                a: 1\n                b: {\n                    c: 2\n                    d: {\n                        e: 3\n                    }\n                }\n            }\n\n            obj.a = 24\n            obj.b.d.e = 42\n\n            <: obj\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "obj",
        "value": {
          "a": {
            "type": "num",
            "value": 24.0
          },
          "b": {
            "type": "obj",
            "value": {
              "c": {
                "type": "num",
                "value": 2.0
              },
              "d": {
                "type": "obj",
                "value": {
                  "e": {
                    "type": "num",
                    "value": 42.0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "index::object::string_key",
      "program": "\n            let obj = {\n                \"\u85cd\": 42,\n            }\n\n            <: obj.\"\u85cd\"\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 42.0
      }
    },
    {
      "name": "index::object::string_key_including_colon_and_period",
      "program": "\n            let obj = {\n                \":.:\": 42,\n            }\n\n            <: obj.\":.:\"\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 42.0
      }
    },
    {
      "name": "index::array::array_item_access",
      "program": "\n            let arr = [\"ai\", \"chan\", \"kawaii\"]\n\n            <: arr[1]\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "str",
        "value": "chan"
      }
    },
    {
      "name": "index::array::array_item_assign",
      "program": "\n            let arr = [\"ai\", \"chan\", \"kawaii\"]\n\n            arr[1] = \"taso\"\n\n            <: arr\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "arr",
        "value": [
          {
            "type": "str",
            "value": "ai"
          },
          {
            "type": "str",
            "value": "taso"
          },
          {
            "type": "str",
            "value": "kawaii"
          }
        ]
      }
    },
    {
      "name": "index::array::assign_array_item_to_out_of_range#1",
      "program": "\n            let arr = [1, 2, 3]\n\n            arr[3] = 4\n\n            <: null\n            ",
      "tags": [
        "core"
      ],
      "expect_error": "runtime"
    },
    {
      "name": "index::array::assign_array_item_to_out_of_range#2",
      "program": "\n            let arr = [1, 2, 3]\n\n            arr[9] = 10\n\n            <: null\n            ",
      "tags": [
        "core"
      ],
      "expect_error": "runtime"
    },
    {
      "name": "index::array::index_out_of_range_error",
      "program": "\n            <: [42][1]\n            ",
      "tags": [
        "core"
      ],
      "expect_error": "runtime"
    },
    {
      "name": "index::array::index_out_of_range_on_assignment",
      "program": "\n            var a = []\n            a[2] = 'hoge'\n            ",
      "tags": [
        "core"
      ],
      "expect_error": "runtime"
    },
    {
      "name": "index::array::non_integer_indexed_assignment",
      "program": "\n            var a = []\n            a[6.21] = 'hoge'\n            ",
      "tags": [
        "core"
      ],
      "expect_error": "runtime"
    },
    {
      "name": "index::chain::chain_access_prop_index_call",
      "program": "\n            let obj = {\n                a: {\n                    b: [@(name) { name }, @(str) { \"chan\" }, @() { \"kawaii\" }],\n                },\n            }\n\n            <: obj.a.b[0](\"ai\")\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "str",
        "value": "ai"
      }
    },
    {
      "name": "index::chain::chained_assign_left_side_prop_index",
      "program": "\n            let obj = {\n                a: {\n                    b: [\"ai\", \"chan\", \"kawaii\"],\n                },\n            }\n\n            obj.a.b[1] = \"taso\"\n\n            <: obj\n            ",
      "tags": [
        "core"
      ],
      "extract_error": "expected ) after obj pair",
      "skip_interpreter": true,
      "skip_vm": true
    },
    {
      "name": "index::chain::chained_assign_right_side_prop_index_call",
      "program": "\n            let obj = {\n                a: {\n                    b: [\"ai\", \"chan\", \"kawaii\"],\n                },\n            }\n\n            var x = null\n            x = obj.a.b[1]\n\n            <: x\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "str",
        "value": "chan"
      }
    },
    {
      "name": "index::chain::chained_inc_dec_left_side_index_prop",
      "program": "\n            let arr = [\n                {\n                    a: 1,\n                    b: 2,\n                }\n            ]\n\n            arr[0].a += 1\n            arr[0].b -= 1\n\n            <: arr\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "arr",
        "value": [
          {
            "type": "obj",
            "value": {
              "a": {
                "type": "num",
                "value": 2.0
              },
              "b": {
                "type": "num",
                "value": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "index::chain::chained_inc_dec_left_side_prop_index",
      "program": "\n            let obj = {\n                a: {\n                    b: [1, 2, 3],\n                },\n            }\n\n            obj.a.b[1] += 1\n            obj.a.b[2] -= 1\n\n            <: obj\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "obj",
        "value": {
          "a": {
            "type": "obj",
            "value": {
              "b": {
                "type": "arr",
                "value": [
                  {
                    "type": "num",
                    "value": 1.0
                  },
                  {
                    "type": "num",
                    "value": 3.0
                  },
                  {
                    "type": "num",
                    "value": 2.0
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "name": "index::chain::prop_in_def",
      "program": "\n            let x = @() {\n                let obj = {\n                    a: 1\n                }\n                obj.a\n            }\n\n            <: x()\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 1.0
      }
    },
    {
      "name": "index::chain::prop_in_return",
      "program": "\n            let x = @() {\n                let obj = {\n                    a: 1\n                }\n                return obj.a\n                2\n            }\n\n            <: x()\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 1.0
      }
    },
    {
      "name": "index::chain::prop_in_each",
      "program": "\n            let msgs = []\n            let x = { a: [\"ai\", \"chan\", \"kawaii\"] }\n            each let item, x.a {\n                let y = { a: item }\n                msgs.push([y.a, \"!\"].join())\n            }\n            <: msgs\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "arr",
        "value": [
          {
            "type": "str",
            "value": "ai!"
          },
          {
            "type": "str",
            "value": "chan!"
          },
          {
            "type": "str",
            "value": "kawaii!"
          }
        ]
      }
    },
    {
      "name": "index::chain::prop_in_for",
      "program": "\n            let x = { times: 10, count: 0 }\n            for (let i, x.times) {\n                x.count = (x.count + i)\n            }\n            <: x.count\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "num",
        "value": 45.0
      }
    },
    {
      "name": "index::chain::object_with_index",
      "program": "\n            let ai = {a: {}}['a']\n            ai['chan'] = 'kawaii'\n            <: ai[{a: 'chan'}['a']]\n            ",
      "tags": [
        "core"
      ],
      "expect": {
        "type": "str",
        "value": "kawaii"
      }
    },
