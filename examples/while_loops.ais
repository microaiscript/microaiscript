// While loop examples

<: "While loop (count to 5):"
var i = 1
while (i <= 5) {
    <: i
    i = i + 1
}

<: ""
<: "While loop with break:"
var j = 1
while (j <= 10) {
    if (j > 3) break
    <: j
    j = j + 1
}

<: ""
<: "While loop with continue (skip even):"
var k = 0
while (k < 6) {
    k = k + 1
    if (k % 2 == 0) continue
    <: k
}

<: ""
<: "Done!"

