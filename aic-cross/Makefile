# aic-cross Makefile
# AiScript Cross-Compiler

CC = gcc
CFLAGS = -Wall -Wextra -std=c11 -O2 -I../include
LDFLAGS = -lm

# Directories
SRC_DIR = .
PARENT_SRC = ../src
PARENT_BUILD = ../build
BUILD_DIR = build

# Source files (aic-cross specific)
CROSS_SRCS = main.c compiler.c optimizer.c
CROSS_OBJS = $(CROSS_SRCS:%.c=$(BUILD_DIR)/%.o)

# Parent library files we need (everything except main.o and interpreter.o)
# We need: parser, scanner, node, memory, value, scope, bytecode, etc.
PARENT_OBJS = \
	$(PARENT_BUILD)/parser.o \
	$(PARENT_BUILD)/scanner.o \
	$(PARENT_BUILD)/node.o \
	$(PARENT_BUILD)/token.o \
	$(PARENT_BUILD)/memory.o \
	$(PARENT_BUILD)/value.o \
	$(PARENT_BUILD)/scope.o \
	$(PARENT_BUILD)/bytecode.o \
	$(PARENT_BUILD)/bytecode_io.o \
	$(PARENT_BUILD)/error.o

# Target executable
TARGET = aic-cross

# Default target
all: $(TARGET)

# Create build directory
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Build aic-cross specific object files
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# Make sure parent objects are built
$(PARENT_OBJS):
	@echo "Building parent library..."
	@cd .. && $(MAKE) --no-print-directory

# Link executable
$(TARGET): $(CROSS_OBJS) $(PARENT_OBJS)
	$(CC) $(CROSS_OBJS) $(PARENT_OBJS) -o $@ $(LDFLAGS)
	@echo ""
	@echo "✓ aic-cross built successfully"
	@echo ""
	@echo "Usage:"
	@echo "  ./aic-cross input.ais           # Compile to input.aic"
	@echo "  ./aic-cross -o out.aic in.ais   # Specify output"
	@echo "  ./aic-cross -O2 input.ais       # Full optimization"
	@echo "  ./aic-cross -h                   # Show help"
	@echo ""

# Clean build artifacts
clean:
	rm -rf $(BUILD_DIR) $(TARGET)

# Test the cross-compiler
test: $(TARGET)
	@echo "Testing aic-cross..."
	@echo '<: "Hello from bytecode!"' > test_input.ais
	@./$(TARGET) -v test_input.ais
	@echo ""
	@echo "Generated bytecode:"
	@ls -lh test_input.aic
	@echo ""
	@echo "Disassembly:"
	@../bin/aiscript -e 'let bc = Core:read_file("test_input.aic")' 2>/dev/null || echo "(Run 'make' in parent dir to test execution)"
	@rm -f test_input.ais test_input.aic

# Install (optional)
install: $(TARGET)
	install -m 755 $(TARGET) /usr/local/bin/aic-cross

# Uninstall (optional)
uninstall:
	rm -f /usr/local/bin/aic-cross

# Help
help:
	@echo "aic-cross Build System"
	@echo ""
	@echo "Targets:"
	@echo "  all       - Build aic-cross (default)"
	@echo "  clean     - Remove build artifacts"
	@echo "  test      - Test the cross-compiler"
	@echo "  install   - Install to /usr/local/bin"
	@echo "  uninstall - Remove from /usr/local/bin"
	@echo "  help      - Show this help"

.PHONY: all clean test install uninstall help

